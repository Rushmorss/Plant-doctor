{
  "info": {
    "name": "Auth API (Flask)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Register",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/auth/register",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "register"
          ]
        },
        "description": "201 Created / 400 / 409",
        "body": {
          "mode": "raw",
          "raw": "{\n    \"full_name\": \"Nguyen Van A\",\n    \"email\": \"example@gmail.com\",\n    \"user_type\": \"student\",\n    \"password\": \"Example@123\",\n    \"confirm_password\": \"Example@123\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "2. Login",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "login"
          ]
        },
        "description": "Lưu access_token / refresh_token vào biến collection",
        "body": {
          "mode": "raw",
          "raw": "{\n    \"email\": \"example@gmail.com\",\n    \"password\": \"Example@123\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const j = pm.response.json();",
              "if (j.success) { pm.collectionVariables.set('access_token', j.data.access_token);",
              "                 pm.collectionVariables.set('refresh_token', j.data.refresh_token); }"
            ]
          }
        }
      ]
    },
    {
      "name": "3. Me (cần access token)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/auth/me",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "me"
          ]
        },
        "description": "",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{access_token}}",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "name": "4. Refresh access token",
      "request": {
        "method": "POST",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/auth/refresh",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "refresh"
          ]
        },
        "description": "",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{refresh_token}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const j = pm.response.json();",
              "if (j.success) { pm.collectionVariables.set('access_token', j.data.access_token); }"
            ]
          }
        }
      ]
    },
    {
      "name": "5. Forgot password - gửi OTP",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/auth/forgot-password",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "forgot-password"
          ]
        },
        "description": "Luôn trả 200 với cùng một thông báo, dù email có tồn tại hay không",
        "body": {
          "mode": "raw",
          "raw": "{\n    \"email\": \"example@gmail.com\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "6. Verify OTP",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/auth/verify-otp",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "verify-otp"
          ]
        },
        "description": "Thay otp bằng mã nhận qua email. Thành công sẽ lưu reset_token.",
        "body": {
          "mode": "raw",
          "raw": "{\n    \"email\": \"example@gmail.com\",\n    \"otp\": \"123456\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const j = pm.response.json();",
              "if (j.success) { pm.collectionVariables.set('reset_token', j.data.reset_token); }"
            ]
          }
        }
      ]
    },
    {
      "name": "7. Reset password",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/auth/reset-password",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "reset-password"
          ]
        },
        "description": "",
        "body": {
          "mode": "raw",
          "raw": "{\n    \"email\": \"example@gmail.com\",\n    \"reset_token\": \"{{reset_token}}\",\n    \"new_password\": \"NewPassword@123\",\n    \"confirm_password\": \"NewPassword@123\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Health check",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/health",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "health"
          ]
        },
        "description": ""
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:5000"
    },
    {
      "key": "access_token",
      "value": ""
    },
    {
      "key": "refresh_token",
      "value": ""
    },
    {
      "key": "reset_token",
      "value": ""
    }
  ]
}