# Backend
FLASK_ENV=production
APP_NAME=Plant Doctor
SECRET_KEY=replace_with_a_random_secret_at_least_32_characters
JWT_SECRET_KEY=replace_with_another_random_secret_at_least_32_characters
DATABASE_URL=mysql+pymysql://USER:PASSWORD@DB_HOST:3306/DB_NAME?charset=utf8mb4
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=your-email@example.com
SMTP_PASSWORD=your-gmail-app-password
FRONTEND_URL=https://your-frontend-domain.example
RATELIMIT_STORAGE_URI=memory://

# Frontend
VITE_API_URL=https://your-backend-domain.example/api
